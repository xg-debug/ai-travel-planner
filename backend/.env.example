# Database (use the credentials of your existing local MySQL container)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/ai_travel_planner?charset=utf8mb4

# Application
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
# JSON array of browser origins; add your deployed web origin before release.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=720
ACCESS_TOKEN_EXPIRE_MINUTES_REMEMBER_ME=43200

# Choose at least one LLM provider. Planning still produces a compact map-based
# fallback if the selected provider is temporarily unavailable.
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Official AMap Streamable HTTP MCP. AMAP_API_KEY remains a compatible key fallback.
MAP_PROVIDER=amap_mcp
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_API_KEY=
AMAP_MCP_MAX_QPS=2
# Optional Web-service route geometry supplement (MCP does not return road vertices).
AMAP_ROAD_GEOMETRY_ENABLED=false
AMAP_API_KEY=
TENCENT_MAP_API_KEY=

# Redis is optional for shared POI and route cache; planning jobs use MySQL.
# When the API runs on the host, use the Docker-published port. When it runs
# inside Docker, use the Redis service name instead of 127.0.0.1.
REDIS_URL=redis://127.0.0.1:6379/0
LOG_LEVEL=INFO
